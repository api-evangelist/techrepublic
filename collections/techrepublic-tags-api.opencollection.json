{
  "opencollection": "1.0.0",
  "info": {
    "name": "TechRepublic WordPress REST Authors Tags API",
    "version": "2.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.techrepublic.com/wp-json/wp/v2/tags",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Current page of the collection."
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Maximum number of items to be returned in result set."
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Limit results to those matching a string."
              },
              {
                "name": "hide_empty",
                "value": "",
                "type": "query",
                "description": "Whether to hide terms not assigned to any posts."
              }
            ]
          },
          "docs": "Retrieve a collection of tags used on TechRepublic."
        },
        {
          "info": {
            "name": "Get Tag",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.techrepublic.com/wp-json/wp/v2/tags/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the tag."
              }
            ]
          },
          "docs": "Retrieve a specific tag by its ID."
        }
      ]
    }
  ],
  "bundled": true
}